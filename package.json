{
  "name": "kids-educational-game",
  "version": "0.1.0",
  "description": "Детская обучающая игра на Phaser + TypeScript + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "android": "cap run android",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.0",
    "@capacitor/core": "^7.6.0",
    "@capacitor/ios": "^7.6.0",
    "@capacitor/screen-orientation": "^7.0.4",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
